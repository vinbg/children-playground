# =============================================================================
# IB Portfolio MCP Server - Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Interactive Brokers Connection
# -----------------------------------------------------------------------------
# Download IB Gateway: https://www.interactivebrokers.com/en/trading/ibgateway-stable.php

# Host where IB Gateway/TWS is running (usually localhost)
IB_HOST=127.0.0.1

# Port for IB Gateway/TWS API connection
# 4001 = IB Gateway Paper Trading (recommended for testing)
# 4002 = IB Gateway Live Trading
# 7497 = TWS Paper Trading
# 7496 = TWS Live Trading
IB_PORT=4001

# Client ID for IB connection (use different IDs if running multiple apps)
IB_CLIENT_ID=1

# -----------------------------------------------------------------------------
# News API (Finnhub)
# -----------------------------------------------------------------------------
# Finnhub API Key (required for news and sentiment features)
# Get your free key at: https://finnhub.io/register
# Free tier: 60 requests/minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# -----------------------------------------------------------------------------
# Sentiment Analysis
# -----------------------------------------------------------------------------
# Model to use for sentiment analysis:
# - "vader": Fast, lightweight, no download required (recommended for most users)
# - "finbert": More accurate for financial text, downloads ~500MB model on first use
SENTIMENT_MODEL=vader

# -----------------------------------------------------------------------------
# Caching (in seconds)
# -----------------------------------------------------------------------------
NEWS_CACHE_TTL=300
SENTIMENT_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
