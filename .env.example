# =============================================================================
# IB Portfolio MCP Server - Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Interactive Brokers Connection
# -----------------------------------------------------------------------------
# Download IB Gateway: https://www.interactivebrokers.com/en/trading/ibgateway-stable.php

# Host where IB Gateway/TWS is running (usually localhost)
IB_HOST=127.0.0.1

# Port for IB Gateway/TWS API connection
# 4001 = IB Gateway Paper Trading (recommended for testing)
# 4002 = IB Gateway Live Trading
# 7497 = TWS Paper Trading
# 7496 = TWS Live Trading
IB_PORT=4001

# Client ID for IB connection (use different IDs if running multiple apps)
IB_CLIENT_ID=1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
